<?xml version="1.0" encoding="utf-8"?>
<!-- The notification icon is referenced only by name from Dart
     (AndroidInitializationSettings('ic_stat_notify')), so the release resource
     shrinker cannot see it and would remove it. Without it the notification
     plugin fails to initialise and every reminder silently fails. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notify" />
